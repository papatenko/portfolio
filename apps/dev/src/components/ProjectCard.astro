---
import type { Project } from '../data/projects';
import { getStars } from '../lib/github';

interface Props { project: Project; featured?: boolean }
const { project, featured = false } = Astro.props;
// Four tags is enough to scan; the case study lists the full stack.
const tags = project.tech.slice(0, 4);

// Live star count at build time, static fallback if offline/rate-limited.
// Counts under 5 read as a broken counter, so they stay hidden.
const fetched = project.repo ? ((await getStars(project.repo)) ?? project.stars ?? null) : null;
const stars = fetched !== null && fetched >= 5 ? fetched : null;
const caseStudyUrl = project.slug ? `/case-studies/${project.slug}/` : null;
---

<article class:list={["card project-card", { featured }]} data-reveal>
  {project.image && (
  <a class="thumb-link pop-sm" href={caseStudyUrl ?? project.demoUrl ?? project.repoUrl ?? '#'} aria-label={`${project.title} details`} tabindex="-1">
    <img
      class:list={['thumb', { 'logo-art': project.logoArt }]}
      src={project.image}
      alt={project.imageAlt ?? `${project.title} screenshot`}
      width="1200"
      height="675"
      loading="lazy"
      decoding="async"
    />
  </a>
  )}
  <div class="body pop">
    <header class="head">
      <h3>
        {caseStudyUrl ? <a href={caseStudyUrl}>{project.title}</a> : project.title}
      </h3>
      {project.status && <span class="status mono">{project.status}</span>}
      {stars !== null && (
        <span class="stars mono" title={`${stars} GitHub stars`}>★ {stars}</span>
      )}
    </header>
    <p class="desc">{project.description}</p>
    <p class="outcome mono">→ {project.outcome}</p>
    {project.credit && <p class="credit">{project.credit}</p>}
    <ul class="tags" role="list">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <footer class="links">
      {caseStudyUrl && <a href={caseStudyUrl} class="link">Case study</a>}
      {project.repoUrl && (
        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="link">GitHub</a>
      )}
      {project.demoUrl && (
        <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="link">Live demo</a>
      )}
    </footer>
  </div>
</article>

<style>
  .project-card { display: flex; flex-direction: column; }
  /* Featured: image and text side by side across the whole grid row. */
  @media (min-width: 900px) {
    .project-card.featured { flex-direction: row; }
    .featured .thumb-link {
      flex: 0 0 55%;
      border-radius: var(--radius) 0 0 var(--radius);
    }
    /* The cover is wider than this box; keep its left edge, where the slide text starts. */
    .featured .thumb { height: 100%; object-position: left center; border-bottom: 0; border-right: 1px solid var(--border); }
    .featured .body { padding: 2rem; justify-content: center; }
    .featured h3 { font-size: 1.6rem; }
  }
  /* The card keeps overflow visible for the 3D tilt, so the image
     clips itself to the card's top corners. */
  .thumb-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .thumb {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  /* Logo art is transparent and uses brand colors that need a light backdrop in both themes. */
  .thumb.logo-art { background: #f8f1e7; }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.3rem;
    flex: 1;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .head h3 { margin: 0; }
  .head a { color: var(--text); }
  .head a:hover { color: var(--accent); }
  .stars { color: var(--gold-ink); font-size: 0.85rem; white-space: nowrap; }
  .status {
    flex: none;
    align-self: start;
    white-space: nowrap;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold-ink);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
  .desc { color: var(--text-muted); font-size: 0.95rem; margin: 0; }
  .outcome {
    color: var(--gold-ink);
    font-size: 0.8rem;
    margin: 0;
  }
  .credit { margin: 0; font-size: 0.8rem; color: var(--text-muted); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    margin-top: auto;
    padding-top: 0.8rem;
  }
  .link {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .link::after {
    content: ' ↗';
    font-size: 0.8em;
  }
</style>
