---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const shown = projects.filter((p) => !p.hidden);
---

<section id="projects" class="section container" aria-labelledby="projects-title">
  <span class="section-label">projects</span>
  <h2 id="projects-title" data-reveal>Featured work</h2>
  <div class="grid">
    {shown.map((project, i) => <ProjectCard project={project} featured={i === 0} />)}
  </div>
</section>

<style>
  .grid > :global(.featured) { grid-column: 1 / -1; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>
