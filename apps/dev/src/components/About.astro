---
import { site } from '../data/site';

// The metric row. Every figure is sourced — see src/data/site.ts.
const stats = site.metrics;
---

<section id="about" class="section container" aria-labelledby="about-title">
  <span class="section-label">about</span>
  <h2 id="about-title" data-reveal>From marketing automation to bare metal</h2>

  <div class="about-grid">
    <div data-reveal>
      <p>
        I'm a developer in {site.location} who likes owning the whole stack — from AI agents
        that draft a client's LinkedIn strategy, down to the Proxmox host they're deployed on.
        I'm the {site.currentRole.title} at{' '}
        {site.currentRole.companyUrl ? (
          <a href={site.currentRole.companyUrl}>{site.currentRole.company}</a>
        ) : (
          <strong>{site.currentRole.company}</strong>
        )}, where I built <strong>Momenta OS</strong> — a Claude-powered agent operating system
        on a governed Google Drive vault, with 60+ versioned skills that turn WordPress audits,
        SEO remediation, and site updates into runbooks an agent can actually follow.
      </p>
      <p>
        Alongside it I'm building a usage-based billing platform on Azure that meters per-lead
        usage into automated Stripe invoicing. It isn't deployed yet, and I'd rather describe it
        precisely than round it up.
      </p>
      <p>
        Before and around all of that: full-stack web apps in React and TypeScript, real-time
        multiplayer systems, and a self-hosted infrastructure practice that treats my homelab
        like production — documented runbooks, tested backups, and all.
      </p>
      <p>
        The creative half of my brain lives at
        <a href="https://papatenko.org/" target="_blank" rel="noopener noreferrer">papatenko.org</a>
        — video editing for YouTube creators and businesses, thumbnails, logos, and poster
        design. Same person, louder colors.
      </p>
      <p class="fun mono">
        <span class="prompt">~$</span> fortune<br />
        <span class="fun-out">{site.funFact}</span>
      </p>
    </div>

    <dl class="stats" data-reveal>
      {stats.map((s) => (
        <div class="stat">
          <dd class="mono">{s.value}</dd>
          <dt>{s.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-top: 1rem;
  }
  .about-grid p { color: var(--text-muted); }
  .about-grid strong { color: var(--text); }
  .prompt { color: var(--gold); }
  .fun {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }
  .fun-out { color: var(--accent); }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
  }
  .stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem;
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  .stat:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .stat dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--accent);
  }
  .stat dt { color: var(--text-muted); font-size: 0.85rem; }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
